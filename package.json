{
  "name": "discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Discord bot with hot-reloaded features, modmail, and active/standby failover",
  "main": "src/index.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "autostart": "node scripts/autostart.js",
    "autostart:remove": "node scripts/autostart.js --remove"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.4.5",
    "mongoose": "^8.9.0"
  }
}
